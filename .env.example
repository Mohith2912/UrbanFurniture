# Copy to .env. Never commit .env or paste its password into chat.
# Supabase/Neon PostgreSQL connection string, with SSL enabled:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Stable secret for cloud deployment (set a long random value in your host):
# URBAN_SECRET=

# Set these only for an HTTPS cloud deployment:
# URBAN_HTTPS=1
# URBAN_HOST=0.0.0.0
# PORT=5050
